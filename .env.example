# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/audiobook_track
# Postgres dedicado para testes (NODE_ENV=test). NUNCA aponta para a base de dev.
TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/audiobook_track_test

# Better Auth
BETTER_AUTH_SECRET=your-secret-key-change-in-production
BETTER_AUTH_URL=http://localhost:1197

# App
NODE_ENV=development
# Versão da aplicação — preencher no build (Vercel: VERCEL_GIT_COMMIT_SHA via projeto)
APP_VERSION=dev

# Sentry (obrigatório em production; opcional em dev/test)
# DSN do projeto. Obtém em https://sentry.io/settings/<org>/projects/<project>/keys/
SENTRY_DSN=
# Slug da organização Sentry (usado pelo plugin de upload de source maps no build)
SENTRY_ORG=
# Slug do projeto Sentry
SENTRY_PROJECT=
# Token de auth para upload de source maps no build (escopo: project:releases)
SENTRY_AUTH_TOKEN=
# URL de check-in do monitor de cron do Sentry (monitor backup-db).
# NÃO é lida pelo app — usada como GitHub Actions secret pelo workflow de backup.
SENTRY_CRON_URL=

# Vercel Cron (obrigatório em production; opcional em dev/test)
# Secret de >= 32 chars usado pelo handler do cron para validar requests do Vercel Cron.
# Gerar com: openssl rand -hex 32
CRON_SECRET=

# Cloudflare R2 — backup diário do banco de produção.
# NÃO são lidas pelo app — usadas como GitHub Actions secrets pelo workflow
# backup-db e localmente no procedimento de restore manual (docs/backup.md §5).
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_ENDPOINT=

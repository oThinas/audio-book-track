{
  "name": "audio-book-track",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack --port 1197",
    "build": "next build",
    "start": "next start",
    "db:generate": "bunx drizzle-kit generate",
    "db:migrate": "bun run src/lib/db/migrate.ts",
    "db:seed": "bun run src/lib/db/seed.ts",
    "db:seed:prod-users": "bun run scripts/seed-prod-users.ts",
    "db:studio": "bunx drizzle-kit studio",
    "db:test:setup": "NODE_ENV=test bun run scripts/db/ensure-test-db.ts && NODE_ENV=test bun run src/lib/db/migrate.ts && NODE_ENV=test bun run src/lib/db/seed-test.ts",
    "db:test:seed": "NODE_ENV=test bun run src/lib/db/seed-test.ts",
    "db:test:clean-orphans": "NODE_ENV=test bun run scripts/db/clean-orphan-schemas.ts",
    "diagnose:seed": "bun run scripts/diagnostics/seed.ts",
    "diagnose:lighthouse": "bun run scripts/diagnostics/lighthouse.ts",
    "diagnose:react": "bun run scripts/diagnostics/react-doctor.ts",
    "diagnose": "bun run diagnose:seed && bun run diagnose:lighthouse && bun run diagnose:react",
    "test": "vitest run && bunx playwright test",
    "test:unit": "vitest run __tests__/unit/",
    "test:integration": "NODE_ENV=test vitest run __tests__/integration/",
    "test:e2e": "NODE_ENV=test bunx playwright test",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "lint": "bunx biome check .",
    "lint:fix": "bunx biome check --write .",
    "prepare": "husky"
  },
  "dependencies": {
    "@base-ui/react": "^1.3.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@hookform/resolvers": "^5.2.2",
    "@neondatabase/serverless": "^1.0.2",
    "@sentry/nextjs": "^10.53.1",
    "@tanstack/react-table": "^8.21.3",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "better-auth": "^1.5.6",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.1.0",
    "date-fns-tz": "^3.2.0",
    "dotenv": "^17.3.1",
    "drizzle-kit": "^0.31.10",
    "drizzle-orm": "^0.45.2",
    "lucide-react": "^1.7.0",
    "next": "16.2.1",
    "next-themes": "^0.4.6",
    "pg": "^8.20.0",
    "radix-ui": "^1.4.3",
    "react": "19.2.4",
    "react-day-picker": "^10.0.0",
    "react-dom": "19.2.4",
    "react-hook-form": "^7.72.1",
    "recharts": "3.8.0",
    "shadcn": "^4.1.2",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.1",
    "@biomejs/biome": "^2.4.10",
    "@faker-js/faker": "^10.4.0",
    "@fast-check/vitest": "^0.4.1",
    "@playwright/test": "^1.59.1",
    "@tailwindcss/postcss": "^4.2.2",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^20.19.37",
    "@types/pg": "^8.20.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/supertest": "^7.2.0",
    "@vitejs/plugin-react": "^6.0.1",
    "@vitest/coverage-v8": "^4.1.2",
    "babel-plugin-react-compiler": "1.0.0",
    "fast-check": "^4.8.0",
    "husky": "^9.1.7",
    "jsdom": "^29.0.2",
    "lighthouse": "^13.4.0",
    "lint-staged": "^16.4.0",
    "puppeteer-core": "^25.2.1",
    "supertest": "^7.2.2",
    "tailwindcss": "^4.2.2",
    "typescript": "^5.9.3",
    "vitest": "^4.1.2"
  },
  "ignoreScripts": [
    "sharp",
    "unrs-resolver"
  ],
  "trustedDependencies": [
    "sharp",
    "unrs-resolver"
  ],
  "lint-staged": {
    "(__tests__|src|scripts)/**/*.{ts,tsx,json}": "bunx biome check --write"
  }
}
